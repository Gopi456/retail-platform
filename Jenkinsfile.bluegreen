pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        choice(
            name: 'ACTION',
            choices: ['DEPLOY', 'ROLLBACK'],
            description: 'Blue-green operation'
        )
        string(
            name: 'VERSION',
            defaultValue: '7.9',
            description: 'Git tag and immutable image version'
        )
        choice(
            name: 'CONFIRM_PROD',
            choices: ['NO', 'YES'],
            description: 'Required for production'
        )
    }

    environment {
        IMAGE = 'orders-api'
        ORDERS_DB = credentials('orders-db-credentials')

        NETWORK = 'orders-network'

        BLUE = 'orders-blue'
        GREEN = 'orders-green'
        DB = 'orders-db'

        BLUE_PORT = '18081'
        GREEN_PORT = '18082'
        NGINX_CONFIG = 'C:/Users/Admin/retail-platform/nginx/default.conf'


        BG_TRAFFIC_SWITCHED = 'false'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                bat 'git fetch --all --tags'
            }
        }

        stage('Validate request') {
            steps {
                script {
                    if (!params.VERSION?.trim()) {
                        error('VERSION is required')
                    }

                    if (params.CONFIRM_PROD != 'YES') {
                        error('Blue-green production deployment requires CONFIRM_PROD=YES')
                    }
                }

                bat 'git rev-parse --verify refs/tags/v%VERSION%'

                script {
                    def shaOutput = bat(
                        script: '@git rev-list -n 1 v%VERSION%',
                        returnStdout: true
                    ).trim()

                    def shaLines = shaOutput.readLines().findAll { it.trim() }

                    if (!shaLines) {
                        error("Unable to resolve commit for tag v${params.VERSION}")
                    }

                    env.GIT_SHA = shaLines.last().trim()
                }

                echo "Release ${params.VERSION} uses commit ${env.GIT_SHA}"
            }
        }

        stage('Prepare infrastructure') {
            steps {
                bat 'docker network inspect %NETWORK% >nul 2>&1 || docker network create %NETWORK%'

                bat 'docker inspect %DB% >nul 2>&1 || docker run -d --name %DB% --network %NETWORK% -e POSTGRES_DB=retaildb -e POSTGRES_USER=retailuser -e POSTGRES_PASSWORD=%ORDERS_DB_PSW% -v orders-db-data:/var/lib/postgresql/data postgres:16-alpine --health-cmd="pg_isready -U retailuser -d retaildb" --health-interval=5s --health-timeout=5s --health-retries=12'

                bat '''
                    for /L %%i in (1,1,30) do (
                        docker exec %DB% pg_isready -U retailuser -d retaildb >nul 2^>^&1
                        if not errorlevel 1 exit /b 0
                        %SystemRoot%\\System32\\ping.exe -n 3 127.0.0.1 >nul
                    )
                    echo Database is not ready.
                    exit /b 1
                '''
            }
        }

        stage('Docker Build') {
            when {
                expression { params.ACTION == 'DEPLOY' }
            }
            steps {
                bat 'docker build --label org.opencontainers.image.revision=%GIT_SHA% -t %IMAGE%:%VERSION% .'
            }
        }

        stage('Docker Image Validation') {
            steps {
                bat 'docker image inspect %IMAGE%:%VERSION%'

                script {
                    def imageRevision = bat(
                        script: '@docker image inspect %IMAGE%:%VERSION% --format="{{index .Config.Labels \\"org.opencontainers.image.revision\\"}}"',
                        returnStdout: true
                    ).trim()

                    def revisionLines = imageRevision.readLines().findAll { it.trim() }

                    if (!revisionLines) {
                        error("Image %IMAGE%:%VERSION% does not contain org.opencontainers.image.revision")
                    }

                    def actualRevision = revisionLines.last().trim()

                    if (actualRevision != env.GIT_SHA) {
                        error(
                            "Immutable image validation failed: " +
                            "expected revision ${env.GIT_SHA}, found ${actualRevision}"
                        )
                    }

                    echo "Image %IMAGE%:%VERSION% is traceable to Git commit ${env.GIT_SHA}"
                }
            }
        }

        stage('Unit/Application Test') {
            when {
                expression { params.ACTION == 'DEPLOY' }
            }
            steps {
                bat 'docker run --rm %IMAGE%:%VERSION% python -m pytest -q -p no:cacheprovider'
            }
        }

        stage('Identify active color') {
            steps {
                script {
                    def proxyConfig = bat(
                        script: '''@%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe -NoProfile -Command "$c = Get-Content -Raw -LiteralPath 'C:/Users/Admin/retail-platform/nginx/default.conf'; if ($c -match 'server orders-blue:8081;') { Write-Output 'server orders-blue:8081;' } elseif ($c -match 'server orders-green:8081;') { Write-Output 'server orders-green:8081;' } else { exit 1 }"''',
                        returnStdout: true
                    ).trim()
                    if (proxyConfig.contains('orders-blue:8081')) {
                        env.BG_ACTIVE = 'orders-blue'
                    } else if (proxyConfig.contains('orders-green:8081')) {
                        env.BG_ACTIVE = 'orders-green'
                    } else {
                        error('Unable to determine active color from nginx/default.conf')
                    }

                    env.BG_CANDIDATE =
                        env.BG_ACTIVE == 'orders-blue' ? 'orders-green' : 'orders-blue'

                    env.BG_CANDIDATE_PORT =
                        env.BG_CANDIDATE == 'orders-blue' ? '18081' : '18082'

                    env.BG_ACTIVE_PORT =
                        env.BG_ACTIVE == 'orders-blue' ? '18081' : '18082'

                    def activeImageOutput = bat(
                        script: "@docker inspect ${env.BG_ACTIVE} --format=\"{{.Config.Image}}\" 2>nul || exit /b 0",
                        returnStdout: true
                    ).trim()

                    def activeImageLines =
                        activeImageOutput.readLines().findAll { it.trim() }

                    env.BG_ACTIVE_IMAGE =
                        activeImageLines
                            ? activeImageLines.last().trim()
                            : 'unknown'

                    echo "BLUE=orders-blue:18081"
                    echo "GREEN=orders-green:18082"
                    echo "ACTIVE=${env.BG_ACTIVE}"
                    echo "CANDIDATE=${env.BG_CANDIDATE}"
                    echo "ACTIVE_IMAGE=${env.BG_ACTIVE_IMAGE}"
                }
            }
        }

        stage('Start candidate') {
            when {
                expression { params.ACTION == 'DEPLOY' }
            }
            steps {
                bat "docker rm -f ${env.BG_CANDIDATE} 2>nul || exit /b 0"

                bat "docker run -d --name ${env.BG_CANDIDATE} --network %NETWORK% -p ${env.BG_CANDIDATE_PORT}:8081 -e APP_VERSION=%VERSION% -e APP_ENVIRONMENT=PRODUCTION -e DB_HOST=%DB% -e DB_NAME=retaildb -e DB_USER=retailuser -e DB_PASSWORD=%ORDERS_DB_PSW% %IMAGE%:%VERSION%"

                echo "DEPLOY candidate ${env.BG_CANDIDATE} started on port ${env.BG_CANDIDATE_PORT}"
            }
        }

        stage('Container Validation') {
            when {
                expression { params.ACTION == 'DEPLOY' }
            }
            steps {
                bat """docker inspect ${env.BG_CANDIDATE} --format="image={{.Config.Image}} status={{.State.Status}} networks={{json .NetworkSettings.Networks}}"""
            }
        }

        stage('Application Health Check') {
            when {
                expression {
                    params.ACTION == 'DEPLOY' ||
                    params.ACTION == 'ROLLBACK'
                }
            }
            steps {
                bat """
                    for /L %%i in (1,1,30) do (
                        for /F "delims=" %%s in ('docker inspect ${env.BG_CANDIDATE} --format="{{.State.Health.Status}}" 2^>nul') do (
                            if /I "%%s"=="healthy" exit /b 0
                        )
                        %SystemRoot%\\System32\\ping.exe -n 3 127.0.0.1 >nul
                    )
                    exit /b 1
                """
            }
        }

        stage('Integration Check') {
            when {
                expression {
                    params.ACTION == 'DEPLOY' ||
                    params.ACTION == 'ROLLBACK'
                }
            }
            steps {
                bat "docker run --rm --network %NETWORK% -e DB_HOST=%DB% -e DB_NAME=retaildb -e DB_USER=retailuser -e DB_PASSWORD=%ORDERS_DB_PSW% %IMAGE%:%VERSION% python -c \"from app.database import get_db_connection; c=get_db_connection(); c.close(); print('database connectivity passed')\""
            }
        }

        stage('Rollback') {
            when {
                expression { params.ACTION == 'ROLLBACK' }
            }
            steps {
                script {
                    echo "Rollback requested"
                    echo "Current active container: ${env.BG_ACTIVE}"
                    echo "Rollback candidate: ${env.BG_CANDIDATE}"
                    echo "Rollback version: ${params.VERSION}"

                    bat "docker rm -f ${env.BG_CANDIDATE} 2>nul || exit /b 0"

                    bat "docker run -d --name ${env.BG_CANDIDATE} --network %NETWORK% -p ${env.BG_CANDIDATE_PORT}:8081 -e APP_VERSION=%VERSION% -e APP_ENVIRONMENT=PRODUCTION -e DB_HOST=%DB% -e DB_NAME=retaildb -e DB_USER=retailuser -e DB_PASSWORD=%ORDERS_DB_PSW% %IMAGE%:%VERSION%"

                    echo "ROLLBACK candidate ${env.BG_CANDIDATE} started on port ${env.BG_CANDIDATE_PORT}"
                    echo "Current active ${env.BG_ACTIVE} remains untouched until candidate validation succeeds"
                }
            }
        }

        stage('Traffic Switch') {
            when {
                expression {
                    params.ACTION == 'DEPLOY' ||
                    params.ACTION == 'ROLLBACK'
                }
            }
            steps {
                script {
                    def proxyTarget = env.BG_CANDIDATE

                    echo "BLUE/GREEN traffic switch"
                    echo "Current active: ${env.BG_ACTIVE}"
                    echo "Candidate: ${proxyTarget}"
                    echo "Switching traffic to: ${proxyTarget}"

                    bat '%SystemRoot%/System32/WindowsPowerShell/v1.0/powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/switch-traffic.ps1 -Target ${proxyTarget} -ConfigPath "%NGINX_CONFIG%"'

                    bat 'docker exec orders-proxy nginx -t'
                    bat 'docker exec orders-proxy nginx -s reload'

                    env.BG_NEW_ACTIVE = env.BG_CANDIDATE
                    env.BG_TRAFFIC_SWITCHED = 'true'

                    echo "Traffic successfully switched to ${proxyTarget}"
                    echo "Previous active container: ${env.BG_ACTIVE}"
                }
            }
        }

        stage('Traffic Verification') {
            when {
                expression {
                    params.ACTION == 'DEPLOY' ||
                    params.ACTION == 'ROLLBACK'
                }
            }
            steps {
                bat "%SystemRoot%\\System32\\curl.exe --fail --silent --show-error http://localhost:18080/health"

                bat "%SystemRoot%\\System32\\curl.exe --fail --silent --show-error http://localhost:18080/db-health"

                bat '''%SystemRoot%\\System32\\curl.exe --fail --silent --show-error http://localhost:18080/health > traffic-health.json
%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoProfile -Command "\$json = Get-Content traffic-health.json -Raw | ConvertFrom-Json; if (\$json.version -ne \"%VERSION%\") { exit 1 }"
'''

                echo "Traffic verification passed for ${env.BG_CANDIDATE}"
                echo "Expected production version: ${params.VERSION}"
            }
        }

        stage('Deployment Verification') {
            steps {
                script {
                    def verifyContainer = env.BG_NEW_ACTIVE

                    if (!verifyContainer?.trim()) {
                        error('No successfully activated container was recorded')
                    }

                    echo "Verifying deployed container: ${verifyContainer}"

                    bat "docker ps --filter name=${verifyContainer}"

                    bat "docker inspect ${verifyContainer} --format=\"image={{.Config.Image}} status={{.State.Status}} health={{.State.Health.Status}}\""

                    bat """docker inspect ${verifyContainer} --format="{{range .Config.Env}}{{println .}}{{end}}" | findstr /B "APP_VERSION=" """

                    bat "%SystemRoot%\\System32\\curl.exe --fail --silent --show-error http://localhost:18080/health"

                    bat "%SystemRoot%\\System32\\curl.exe --fail --silent --show-error http://localhost:18080/db-health"

                    echo "Deployment verification passed for ${verifyContainer}"
                }
            }
        }

        stage('Old Version Cleanup') {
            when {
                expression {
                    params.ACTION == 'DEPLOY' ||
                    params.ACTION == 'ROLLBACK'
                }
            }
            steps {
                bat "docker rm -f ${env.BG_ACTIVE} 2>nul || exit /b 0"

                echo "Previous active container ${env.BG_ACTIVE} removed only after successful traffic and deployment verification."

                echo "New active container: ${env.BG_NEW_ACTIVE}"
            }
        }
    }

    post {
        failure {
            script {
                if (env.BG_TRAFFIC_SWITCHED != 'true') {

                    bat "docker rm -f ${env.BG_CANDIDATE} 2>nul || exit /b 0"

                    echo "FAILURE before traffic switch."
                    echo "Candidate ${env.BG_CANDIDATE ?: 'unknown'} removed."
                    echo "Previous active container ${env.BG_ACTIVE ?: 'unknown'} retained."

                } else {

                    echo "FAILURE after traffic switch."
                    echo "Restoring traffic to previous active container ${env.BG_ACTIVE}"

                    bat '%SystemRoot%/System32/WindowsPowerShell/v1.0/powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/switch-traffic.ps1 -Target ${env.BG_ACTIVE} -ConfigPath "%NGINX_CONFIG%"'

                    bat 'docker exec orders-proxy nginx -t'
                    bat 'docker exec orders-proxy nginx -s reload'

                    bat "%SystemRoot%\\System32\\curl.exe --fail --silent --show-error http://localhost:18080/health"

                    bat "docker rm -f ${env.BG_CANDIDATE} 2>nul || exit /b 0"

                    echo "Traffic restored to previous active container ${env.BG_ACTIVE}."
                    echo "Failed candidate ${env.BG_CANDIDATE} removed."
                }

                echo "Failure handling:"
                echo "trafficSwitched=${env.BG_TRAFFIC_SWITCHED ?: 'false'}"
                echo "candidate=${env.BG_CANDIDATE ?: 'unknown'}"
                echo "active=${env.BG_ACTIVE ?: 'unknown'}"
                echo "newActive=${env.BG_NEW_ACTIVE ?: 'unknown'}"
                echo "version=${params.VERSION}"
                echo "commit=${env.GIT_SHA ?: 'unknown'}"
            }
        }

        always {
            bat 'docker ps -a'
            bat 'docker images orders-api'

            echo "Final result=${currentBuild.currentResult}"
            echo "Version=${params.VERSION}"
            echo "Git commit=${env.GIT_SHA ?: 'unknown'}"
            echo "Active=${env.BG_ACTIVE ?: 'unknown'}"
            echo "Candidate=${env.BG_CANDIDATE ?: 'unknown'}"
            echo "New active=${env.BG_NEW_ACTIVE ?: 'unknown'}"
        }
    }
}
