pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        choice(name: 'ACTION', choices: ['DEPLOY', 'ROLLBACK'], description: 'Blue-green operation')
        string(name: 'VERSION', defaultValue: '7.9', description: 'Git tag and immutable image version')
        choice(name: 'CONFIRM_PROD', choices: ['NO', 'YES'], description: 'Required for production')
    }

    environment {
        IMAGE = 'orders-api'
        ORDERS_DB = credentials('orders-db-credentials')
        NETWORK = 'orders-network'
        BLUE = 'orders-blue'
        GREEN = 'orders-green'
        DB = 'orders-db'
        ACTIVE_PORT = '18081'
        BLUE_PORT = '18081'
        GREEN_PORT = '18082'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                bat 'git fetch --all --tags'
            }
        }

        stage('Validate request') {
            steps {
                script {
                    if (!params.VERSION?.trim()) { error('VERSION is required') }
                    if (params.CONFIRM_PROD != 'YES') { error('Blue-green production deployment requires CONFIRM_PROD=YES') }
                }
                bat 'git rev-parse --verify refs/tags/v%VERSION%'
                script {
                    def shaOutput = bat(script: '@git rev-list -n 1 v%VERSION%', returnStdout: true).trim()
                    env.GIT_SHA = shaOutput.readLines().findAll { it.trim() }.last().trim()
                }
                echo "Release ${params.VERSION} uses commit ${env.GIT_SHA}"
            }
        }

        stage('Prepare infrastructure') {
            when { expression { params.ACTION == 'DEPLOY' } }
            steps {
                bat 'docker network inspect %NETWORK% >nul 2>&1 || docker network create %NETWORK%'
                bat 'docker inspect %DB% >nul 2>&1 || docker run -d --name %DB% --network %NETWORK% -e POSTGRES_DB=retaildb -e POSTGRES_USER=retailuser -e POSTGRES_PASSWORD=%ORDERS_DB_PSW% -v orders-db-data:/var/lib/postgresql/data postgres:16-alpine'
                bat '''
                    for /L %%i in (1,1,30) do (
                        for /F "delims=" %%s in ('docker inspect %DB% --format="{{.State.Status}}" 2^>nul') do (
                            if /I "%%s"=="running" exit /b 0
                        )
                        %SystemRoot%\\System32\\ping.exe -n 3 127.0.0.1 >nul
                    )
                    exit /b 1
                '''
            }
        }

        stage('Docker Build') {
            when { expression { params.ACTION == 'DEPLOY' } }
            steps { bat 'docker build --label org.opencontainers.image.revision=%GIT_SHA% -t %IMAGE%:%VERSION% .' }
        }

        stage('Docker Image Validation') {
            when { expression { params.ACTION == 'DEPLOY' } }
            steps { bat 'docker image inspect %IMAGE%:%VERSION%' }
        }

        stage('Unit/Application Test') {
            when { expression { params.ACTION == 'DEPLOY' } }
            steps { bat 'docker run --rm %IMAGE%:%VERSION% python -m pytest -q -p no:cacheprovider' }
        }

        stage('Identify active color') {
            steps {
                script {
                    def proxyConfig = bat(
                        script: '@findstr /C:"server orders-blue:8081;" /C:"server orders-green:8081;" nginx\\default.conf',
                        returnStdout: true
                    ).trim()

                    if (proxyConfig.contains('orders-blue:8081')) {
                        env.ACTIVE = env.BLUE
                    } else if (proxyConfig.contains('orders-green:8081')) {
                        env.ACTIVE = env.GREEN
                    } else {
                        error('Unable to determine active color from nginx/default.conf')
                    }

                    env.CANDIDATE = env.ACTIVE == env.BLUE ? env.GREEN : env.BLUE
                    env.CANDIDATE_PORT = env.CANDIDATE == env.BLUE ? env.BLUE_PORT : env.GREEN_PORT
                    env.ACTIVE_PORT = env.ACTIVE == env.BLUE ? env.BLUE_PORT : env.GREEN_PORT

                    def activeImageOutput = bat(
                        script: "@docker inspect ${env.ACTIVE} --format=\"{{.Config.Image}}\" 2>nul || exit /b 0",
                        returnStdout: true
                    ).trim()

                    def activeImageLines = activeImageOutput.readLines().findAll { it.trim() }
                    env.ACTIVE_IMAGE = activeImageLines ? activeImageLines.last().trim() : 'unknown'

                    echo "BLUE=${env.BLUE}:${env.BLUE_PORT}; GREEN=${env.GREEN}:${env.GREEN_PORT}; active=${env.ACTIVE}; candidate=${env.CANDIDATE}; activeImage=${env.ACTIVE_IMAGE}"
                }
            }
        }

        stage('Start candidate') {
            when { expression { params.ACTION == 'DEPLOY' } }
            steps {
                bat 'docker rm -f %CANDIDATE% 2>nul || exit /b 0'
                bat 'docker run -d --name %CANDIDATE% --network %NETWORK% -p %CANDIDATE_PORT%:8081 -e APP_VERSION=%VERSION% -e APP_ENVIRONMENT=PRODUCTION -e DB_HOST=%DB% -e DB_NAME=retaildb -e DB_USER=retailuser -e DB_PASSWORD=%ORDERS_DB_PSW% %IMAGE%:%VERSION%'
            }
        }

        stage('Container Validation') {
            when { expression { params.ACTION == 'DEPLOY' } }
            steps { bat 'docker inspect %CANDIDATE% --format="image={{.Config.Image}} status={{.State.Status}} network={{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}"' }
        }

        stage('Application Health Check') {
            when { expression { params.ACTION == 'DEPLOY' } }
            steps {
                bat '''
                    for /L %%i in (1,1,30) do (
                        for /F "delims=" %%s in ('docker inspect %CANDIDATE% --format="{{.State.Health.Status}}" 2^>nul') do (
                            if /I "%%s"=="healthy" exit /b 0
                        )
                        %SystemRoot%\\System32\\ping.exe -n 3 127.0.0.1 >nul
                    )
                    exit /b 1
                '''
            }
        }

        stage('Integration Check') {
            when { expression { params.ACTION == 'DEPLOY' } }
            steps { bat "docker run --rm --network %NETWORK% -e DB_HOST=%DB% -e DB_NAME=retaildb -e DB_USER=retailuser -e DB_PASSWORD=%ORDERS_DB_PSW% %IMAGE%:%VERSION% python -c \"from app.database import get_db_connection; c=get_db_connection(); c.close(); print('database connectivity passed')\"" }
        }

        stage('Traffic Switch') {
            when { expression { params.ACTION == 'DEPLOY' } }
            steps {
                script {
                    def proxyTarget = env.CANDIDATE

                    echo "Switching traffic from ${env.ACTIVE} to ${proxyTarget}"

                    bat "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/switch-traffic.ps1 -Target ${proxyTarget}"

                    bat 'docker exec orders-proxy nginx -t'
                    bat 'docker exec orders-proxy nginx -s reload'

                    echo "Traffic switched to ${proxyTarget}"
                    env.NEW_ACTIVE = env.CANDIDATE
                    env.TRAFFIC_SWITCHED = 'true'
                    echo "Previous active container: ${env.ACTIVE}"
                }
            }
        }


        stage('Traffic Verification') {
            when { expression { params.ACTION == 'DEPLOY' } }
            steps {
                bat 'curl.exe --fail --silent --show-error http://localhost:18080/health'
                bat 'curl.exe --fail --silent --show-error http://localhost:18080/db-health'
                echo "Traffic verification passed for ${env.CANDIDATE}"
            }
        }



        stage('Rollback') {
            when { expression { params.ACTION == 'ROLLBACK' } }
            steps {
                bat 'docker rm -f %ACTIVE% 2>nul || exit /b 0'
                bat 'docker run -d --name %ACTIVE% --network %NETWORK% -p %ACTIVE_PORT%:8081 -e APP_VERSION=%VERSION% -e APP_ENVIRONMENT=PRODUCTION -e DB_HOST=%DB% -e DB_NAME=retaildb -e DB_USER=retailuser -e DB_PASSWORD=%ORDERS_DB_PSW% %IMAGE%:%VERSION%'
            }
        }

        stage('Deployment Verification') {
            steps {
            script {
                def verifyContainer = params.ACTION == 'DEPLOY' ? env.NEW_ACTIVE : env.ACTIVE

                echo "Verifying deployed container: ${verifyContainer}"

                bat "docker ps --filter name=${verifyContainer} --filter name=%DB%"

                bat "docker inspect ${verifyContainer} --format=\"image={{.Config.Image}} status={{.State.Status}} health={{.State.Health.Status}}\""

                bat "curl.exe --fail --silent --show-error http://localhost:18080/health"

                bat "curl.exe --fail --silent --show-error http://localhost:18080/db-health"
            }
        }

        stage('Old Version Cleanup') {
            when { expression { params.ACTION == 'DEPLOY' } }
            steps {
                bat 'docker rm -f %ACTIVE% 2>nul || exit /b 0'
                echo "Previous active container %ACTIVE% removed after successful deployment verification."
            }
        }

    }


    post {
        failure {
            script {
                if (env.TRAFFIC_SWITCHED != 'true') {
                    bat 'docker rm -f %CANDIDATE% 2>nul || exit /b 0'
                    echo "Candidate removed; previous active container retained."
                } else {
                    echo "Deployment failed after traffic switch; restoring traffic to ${env.ACTIVE}"
                    bat "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/switch-traffic.ps1 -Target ${env.ACTIVE}"
                    bat 'docker exec orders-proxy nginx -t'
                    bat 'docker exec orders-proxy nginx -s reload'
                    bat "curl.exe --fail --silent --show-error http://localhost:18080/health"
                    bat 'docker rm -f %CANDIDATE% 2>nul || exit /b 0'
                    echo "Traffic restored to previous active container ${env.ACTIVE}; failed candidate removed."
                }
                echo "Failure handling: trafficSwitched=${env.TRAFFIC_SWITCHED ?: 'false'}; candidate=${env.CANDIDATE ?: 'unknown'}; active=${env.ACTIVE ?: 'unknown'}; newActive=${env.NEW_ACTIVE ?: 'unknown'}"
            }
        }
        always {
            bat 'docker ps -a'
            bat 'docker images orders-api'
            echo "Final result=${currentBuild.currentResult}; version=${params.VERSION}; commit=${env.GIT_SHA ?: 'unknown'}"
        }
    }
}
